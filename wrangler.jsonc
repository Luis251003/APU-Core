{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "apu-core",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    },
    "vars": {
        "CONTACT_FROM_EMAIL": "contacto@apucore.com",
        "CONTACT_TO_EMAIL": "luisortiz251003@gmail.com"
    }
  }
}
